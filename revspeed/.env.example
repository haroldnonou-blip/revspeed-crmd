# RevSpeed CRM — Variables d'environnement
# Copier ce fichier en .env.local pour le développement
# Configurer ces mêmes variables dans Vercel > Settings > Environment Variables

# ── Supabase (optionnel — active l'import automatique des leads Facebook) ───
# Récupérer dans : https://supabase.com/dashboard → ton projet → Settings → API
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXX

# ── Protection par mot de passe (optionnel — recommandé en production) ──────
# Choisir un mot de passe robuste pour protéger l'accès au CRM
VITE_ACCESS_PASSWORD=

